{
  "name": "tex-giang-recruitment",
  "private": true,
  "version": "1.0.0",
  "description": "Build Tailwind CSS cho website tuyển dụng TEX-GIANG (PHP)",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/tailwind.source.css -o public/assets/css/utilities.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.source.css -o public/assets/css/utilities.css --watch",
    "serve": "powershell -ExecutionPolicy Bypass -File tools/serve.ps1"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.2",
    "datatables.net": "^2.3.8",
    "datatables.net-bs5": "^2.3.8",
    "jquery": "^3.7.1",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "3.4.17"
  }
}
